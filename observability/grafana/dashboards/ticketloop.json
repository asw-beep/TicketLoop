        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (handler) (rate(http_requests_total{status=\"4xx\"}[1m]))",
          "legendFormat": "4xx {{handler}}"
        }
