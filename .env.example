# Copy this file to .env for local development. Never commit .env.
# Every value here has a matching default in app/core/config.py or docker-compose.yml,
# so the app also runs without a .env at all.

# --- API (read by app/core/config.py) ---
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://ticketloop:ticketloop@localhost:5432/ticketloop
LOG_LEVEL=INFO
# true: one JSON object per line. false: readable coloured lines while developing.
LOG_JSON=true

# Signs access tokens (HS256). Optional locally: a built-in development key is used, and
# staging and production refuse to start with it. At least 32 bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=30
# Where reset emails link to: the frontend.
FRONTEND_URL=http://localhost:5173

# Email. Unset, a laptop (ENVIRONMENT=local) sends to Mailpit on localhost:1025,
# whose inbox is at http://localhost:8025. Tests keep email in memory.
# SMTP_HOST=localhost
# SMTP_PORT=1025

# Object storage for ticket evidence (M4): MinIO in docker-compose.yml, any S3-compatible
# server elsewhere. The API calls STORAGE_ENDPOINT_URL. Download links are signed for
# STORAGE_PUBLIC_URL, the host the browser reaches; unset means the same as the endpoint.
# The access and secret keys are also MinIO's root user and password in docker-compose.yml.
# Staging and production refuse to start with the built-in secret.
STORAGE_ENDPOINT_URL=http://localhost:9000
# STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_BUCKET=ticketloop-documents
STORAGE_ACCESS_KEY=ticketloop
STORAGE_SECRET_KEY=ticketloop-local-secret
STORAGE_REGION=us-east-1

# --- Postgres container (read by docker-compose.yml) ---
POSTGRES_USER=ticketloop
POSTGRES_PASSWORD=ticketloop
POSTGRES_DB=ticketloop
