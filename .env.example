# Copy this file to .env for local development. Never commit .env.
# Every value here has a matching default in app/core/config.py or docker-compose.yml,
# so the app also runs without a .env at all.

# --- API (read by app/core/config.py) ---
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://ticketloop:ticketloop@localhost:5432/ticketloop
LOG_LEVEL=INFO
# true: one JSON object per line. false: readable coloured lines while developing.
LOG_JSON=true

# --- Postgres container (read by docker-compose.yml) ---
POSTGRES_USER=ticketloop
POSTGRES_PASSWORD=ticketloop
POSTGRES_DB=ticketloop
